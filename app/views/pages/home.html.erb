<section class="hero">
  <div class="wrap hero-grid">
    <div>
      <p class="eyebrow">Made to order in Northern Virginia</p>
      <h1>Personalized things, printed one at a time.</h1>
      <p class="lede">Coasters, watch stands, desk signs and gifts, made with your colors and your words.</p>
      <div class="actions">
        <%= link_to "Shop on Etsy", Catalog::SHOP_URL, class: "btn", target: "_blank", rel: "noopener" %>
        <%= link_to "Ask for something custom", made_to_order_path, class: "btn ghost" %>
      </div>
    </div>
    <div class="hero-photo"><%= image_tag "photos/watch-stands-group.jpg", alt: "Five Apple Watch stands in blue, tan, purple and orange on a white table" %></div>
  </div>
</section>

<section class="block">
  <div class="wrap">
    <p class="eyebrow">A few favorites</p>
    <h2>Made for your desk, your table and your gifts.</h2>
    <div class="products">
      <% @featured.each do |item| %><%= render "shared/product", item: item %><% end %>
    </div>
    <p class="more"><%= link_to "See everything we make", shop_path %></p>
  </div>
</section>

<section class="block alt">
  <div class="wrap two">
    <div>
      <p class="eyebrow">How it works</p>
      <h2>Your colors. Your words. Printed for you.</h2>
      <ol class="steps">
        <li><b>Choose a product.</b> Coasters, watch stands, signs and more.</li>
        <li><b>Pick up to two colors.</b> We keep about fifteen colors of filament on hand.</li>
        <li><b>Add your text.</b> A name, a date, a quote or a logo.</li>
        <li><b>We print it and send it.</b> Each piece is made to order.</li>
      </ol>
      <p><%= link_to "Don't see it? Ask for it", made_to_order_path, class: "btn" %></p>
    </div>
    <div class="photo-pair">
      <%= image_tag "photos/coaster-holder-red.jpg", alt: "A red coaster holder with colorful coasters stacked inside" %>
      <%= image_tag "photos/watch-stands-three.jpg", alt: "Three watch stands in tan, blue and orange, one holding a watch" %>
    </div>
  </div>
</section>

<section class="block">
  <div class="wrap">
    <p class="eyebrow">Art by Lena</p>
    <h2>Original paintings, printed as coasters.</h2>
    <div class="products three">
      <% Catalog.lena.each do |item| %><%= render "shared/product", item: item %><% end %>
    </div>
  </div>
</section>

<section class="block">
  <div class="wrap">
    <div class="cta-band">
      <div><h3>Have something in mind?</h3><p>Names, logos, events, gifts for a team. If it isn't listed, ask.</p></div>
      <%= link_to "Made to order", made_to_order_path, class: "btn" %>
    </div>
  </div>
</section>
