<section class="hero">
  <div class="wrap hero-grid">
    <div>
      <p class="eyebrow">A small family shop in Northern Virginia</p>
      <h1>Made at our desk, just for you.</h1>
      <p class="lede">Coasters, watch stands, desk signs and gifts, printed one at a time with your colors and your words.</p>
      <div class="actions">
        <%= link_to "Shop on Etsy", Catalog::SHOP_URL, class: "btn", target: "_blank", rel: "noopener" %>
        <%= link_to "Ask for something custom", made_to_order_path, class: "btn ghost" %>
      </div>
    </div>
    <figure class="snap"><%= image_tag "photos/our-desk.jpg", alt: "A purple Apple Watch stand with the name Troy on it, on a wooden desk next to a tin bucket" %><figcaption>A watch stand with a name on it, on our desk</figcaption></figure>
  </div>
</section>

<section class="block">
  <div class="wrap hello">
    <p class="eyebrow">Hello from the shop</p>
    <h2>Every piece is printed here, for one person at a time.</h2>
    <p>We are a small family business. We print on our own machines, we keep a small palette of colors on the shelf, and we are happy to talk an idea through before we print it.</p>
  </div>
</section>

<section class="block alt">
  <div class="wrap">
    <p class="eyebrow">A few favorites</p>
    <h2>Made for your desk, your table and your gifts.</h2>
    <div class="products">
      <% @featured.each do |item| %><%= render "shared/product", item: item %><% end %>
    </div>
    <p class="more"><%= link_to "See everything we make", shop_path %></p>
  </div>
</section>

<section class="block">
  <div class="wrap two">
    <div>
      <p class="eyebrow">How it works</p>
      <h2>Your colors. Your words. Printed for you.</h2>
      <ol class="steps">
        <li><b>Choose a product.</b> Coasters, watch stands, signs and more.</li>
        <li><b>Pick up to two colors.</b> Black, white, grey, navy, tan, chocolate brown or ruby red.</li>
        <li><b>Add your text.</b> A name, a date, a quote or a logo.</li>
        <li><b>We print it and send it.</b> Each piece is made to order.</li>
      </ol>
      <p><%= link_to "Don't see it? Ask for it", made_to_order_path, class: "btn" %></p>
    </div>
    <div class="photo-pair">
      <%= image_tag "photos/coaster-holder-red.jpg", alt: "A red coaster holder with colorful coasters stacked inside" %>
      <%= image_tag "photos/watch-stands-three.jpg", alt: "Three watch stands in tan, blue and orange, one holding a watch" %>
    </div>
  </div>
</section>

<section class="block alt">
  <div class="wrap">
    <p class="eyebrow">Art by Lena</p>
    <h2>Original paintings, set into coasters we print.</h2>
    <div class="products three">
      <% Catalog.lena.each do |item| %><%= render "shared/product", item: item %><% end %>
    </div>
  </div>
</section>

<section class="block">
  <div class="wrap">
    <div class="cta-band">
      <div><h3>Have something in mind?</h3><p>Names, logos, events, gifts for a team. If it isn't listed, ask.</p></div>
      <%= link_to "Made to order", made_to_order_path, class: "btn" %>
    </div>
  </div>
</section>
